      "id": "das-basic",
      "name": "DAS Repository - Basic Operation",
      "description": "Verify DAS repos can run simulation without crashing",
      "config": {
        "repositoryType": "DAS",
        "jobType": "ForwardIncremental",
        "sourceDataTB": 1,
        "annualGrowthRatePct": 10,
        "dailyChangeRatePct": 5,
