        "gfsPolicy": {"weekly": 0, "monthly": 0, "yearly": 0},
        "offloadAfterDays": 7,
        "archiveAfterDays": 14,
        "hasArchiveTier": false,
        "copyEnabled": false,
        "moveEnabled": false
      },
      "totalDays": 16,
      "checkpoints": [
