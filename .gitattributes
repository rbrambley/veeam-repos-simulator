* text=auto

# Keep generated docs stable across OS line ending defaults
docs/*.html text eol=lf
docs/*.json text eol=lf

# Source and config files should stay LF across platforms
*.ts text eol=lf
*.tsx text eol=lf
*.js text eol=lf
*.jsx text eol=lf
*.json text eol=lf
*.md text eol=lf
*.css text eol=lf
*.scss text eol=lf
*.yml text eol=lf
*.yaml text eol=lf

# Git hooks/scripts must remain LF
.husky/* text eol=lf
